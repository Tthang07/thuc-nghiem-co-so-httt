PREFIX : <https://myinsurancecompany.linked.data.world/d/chat-with-the-data-benchmark/>
PREFIX ds-omg-pc-database: <https://myinsurancecompany.linked.data.world/d/omg-pc-database/>
PREFIX in: <http://data.world/schema/insurance/>

select ?PolicyNumber ?ClaimNumber
where{
    SERVICE ds-omg-pc-database:mapped {
        ?policy a in:Policy;
            in:policyNumber ?PolicyNumber;
        .
        ?coverage a in:PolicyCoverageDetail;
            in:hasPolicy ?policy;
        .

        ?claim a in:Claim;
            in:claimNumber ?ClaimNumber;
            in:against ?coverage;
        .

        
    }

}
