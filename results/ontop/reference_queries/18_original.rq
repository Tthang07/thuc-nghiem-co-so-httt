PREFIX : <https://myinsurancecompany.linked.data.world/d/chat-with-the-data-benchmark/>
PREFIX ds-omg-pc-database: <https://myinsurancecompany.linked.data.world/d/omg-pc-database/>
PREFIX in: <http://data.world/schema/insurance/>
PREFIX fn: <http://data.world/function/functions#>


select ?PolicyNumber (avg(?Diff) as ?AvgDaysToSettle)
where{
    SERVICE ds-omg-pc-database:mapped {
        ?policy a in:Policy;
            in:policyNumber ?PolicyNumber;
        .
        ?coverage in:hasPolicy ?policy. 
        ?claim in:against ?coverage.     
        ?claim rdf:type in:Claim;
            in:claimNumber ?ClaimNumber;
            in:claimOpenDate ?ClaimOpenDate;
            in:claimCloseDate ?ClaimCloseDate;
        .
    }
    BIND(fn:date_diff(?ClaimOpenDate, ?ClaimCloseDate, "day") as ?Diff)
}
group by ?PolicyNumber
