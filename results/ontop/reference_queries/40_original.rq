PREFIX : <https://myinsurancecompany.linked.data.world/d/chat-with-the-data-benchmark/>
PREFIX ds-omg-pc-database: <https://myinsurancecompany.linked.data.world/d/omg-pc-database/>
PREFIX in: <http://data.world/schema/insurance/>

select ?agentId (sum(?TotalLoss) as ?TotalLossSum) 
where{
    SERVICE ds-omg-pc-database:mapped {
        ?policy a in:Policy;
            in:policyNumber ?PolicyNumber;
            in:soldByAgent [ in:agentId ?agentId];
        .
        ?coverage in:hasPolicy ?policy. 
        ?claim in:against ?coverage.     

        ?claim rdf:type in:Claim;
            in:claimNumber ?ClaimNumber;
            in:hasLossPayment [
                in:lossPaymentAmount ?LossPaymentAmount;
            ];
            in:hasLossReserve [
                in:lossReserveAmount ?LossReserveAmount;
            ];
            in:hasExpensePayment [
                in:expensePaymentAmount ?ExpensePaymentAmount;
            ];
            in:hasExpenseReserve [
                in:expenseReserveAmount ?ExpenseReserveAmount;
            ];
        .
    }
    bind (?LossPaymentAmount+ ?LossReserveAmount+ ?ExpensePaymentAmount + ?ExpenseReserveAmount as ?TotalLoss)

}
group by ?agentId
