PREFIX ins: <http://data.world/schema/insurance/>

SELECT ?catastropheName ?policyNumber
       (SUM(?lossPaymentVal + ?lossReserveVal + ?expensePaymentVal + ?expenseReserveVal) AS ?totalLoss)
WHERE {
  {
    ?claim a ins:Claim ;
           ins:against ?pcd ;
           ins:hasCatastrophe ?cat .

    ?cat ins:catastropheName ?catastropheName .

    ?pcd ins:hasPolicy ?policy .
    ?policy ins:policyNumber ?policyNumber .

    OPTIONAL {
      ?claim ins:hasLossPayment ?lp .
      ?lp ins:lossPaymentAmount ?lpAmt .
    }

    OPTIONAL {
      ?claim ins:hasLossReserve ?lr .
      ?lr ins:lossReserveAmount ?lrAmt .
    }

    OPTIONAL {
      ?claim ins:hasExpensePayment ?ep .
      ?ep ins:expensePaymentAmount ?epAmt .
    }

    OPTIONAL {
      ?claim ins:hasExpenseReserve ?er .
      ?er ins:expenseReserveAmount ?erAmt .
    }

    BIND(COALESCE(xsd:decimal(?lpAmt), 0) AS ?lossPaymentVal)
    BIND(COALESCE(xsd:decimal(?lrAmt), 0) AS ?lossReserveVal)
    BIND(COALESCE(xsd:decimal(?epAmt), 0) AS ?expensePaymentVal)
    BIND(COALESCE(xsd:decimal(?erAmt), 0) AS ?expenseReserveVal)
  }
}
GROUP BY ?catastropheName ?policyNumber
ORDER BY ?catastropheName ?policyNumber