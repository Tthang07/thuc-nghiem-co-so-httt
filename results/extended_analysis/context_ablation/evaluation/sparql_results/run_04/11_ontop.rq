PREFIX ins: <http://data.world/schema/insurance/>

SELECT ?policyNumber (COUNT(DISTINCT ?claim) AS ?claimCount)
WHERE {
  {
    ?claim a ins:Claim ;
           ins:against ?coverage .
    ?coverage ins:hasPolicy ?policy .
    ?policy ins:policyNumber ?policyNumber .
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber