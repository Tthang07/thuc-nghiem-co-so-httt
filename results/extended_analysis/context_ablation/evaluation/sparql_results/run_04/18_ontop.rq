PREFIX ins: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber (AVG(?daysToSettle) AS ?avgTimeToSettleDays)
WHERE {
  {
    ?claim a ins:Claim ;
           ins:claimOpenDate ?openDate ;
           ins:claimCloseDate ?closeDate ;
           ins:against ?pcd .
    
    ?pcd ins:hasPolicy ?policy .
    ?policy ins:policyNumber ?policyNumber .

    BIND((xsd:dateTime(?closeDate) - xsd:dateTime(?openDate)) / "P1D"^^xsd:dayTimeDuration AS ?daysToSettle)
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber