PREFIX ins: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?agentId
       (SUM(DISTINCT ?lossAmt) AS ?totalLoss)
       (SUM(DISTINCT ?premAmt) AS ?totalPremium)
       ((SUM(DISTINCT ?lossAmt) / SUM(DISTINCT ?premAmt)) AS ?lossRatio)
WHERE {
  {
    ?policy a ins:Policy ;
            ins:policyNumber ?policyNumber ;
            ins:soldByAgent ?agent .

    ?agent ins:agentId ?agentId .

    ?coverage a ins:PolicyCoverageDetail ;
              ins:hasPolicy ?policy ;
              ins:hasPremiumAmount ?premium .

    ?premium ins:premiumAmount ?premAmt .

    OPTIONAL {
      ?claim a ins:Claim ;
             ins:against ?coverage .

      OPTIONAL {
        ?claim ins:hasLossPayment ?lp .
        ?lp ins:lossPaymentAmount ?lpAmt .
      }

      OPTIONAL {
        ?claim ins:hasLossReserve ?lr .
        ?lr ins:lossReserveAmount ?lrAmt .
      }

      BIND((COALESCE(?lpAmt, 0) + COALESCE(?lrAmt, 0)) AS ?lossAmt)
    }
  }
}
GROUP BY ?policyNumber ?agentId
ORDER BY ?policyNumber ?agentId