SELECT ?policyNumber (SUM(?lossPaymentAmount + ?lossReserveAmount + ?expensePaymentAmount + ?expenseReserveAmount) AS ?averageLoss)
FROM SERVICE <mapped> {
  ?policy in:hasPolicyCoverageDetail ?policyCoverageDetail .
  ?policyCoverageDetail in:hasLossPayment ?lossPayment .
  ?policyCoverageDetail in:hasLossReserve ?lossReserve .
  ?policyCoverageDetail in:hasExpensePayment ?expensePayment .
  ?policyCoverageDetail in:hasExpenseReserve ?expenseReserve .
  ?lossPayment in:lossPaymentAmount ?lossPaymentAmount .
  ?lossReserve in:lossReserveAmount ?lossReserveAmount .
  ?expensePayment in:expensePaymentAmount ?expensePaymentAmount .
  ?expenseReserve in:expenseReserveAmount ?expenseReserveAmount .
  ?policy in:policyNumber ?policyNumber .
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber