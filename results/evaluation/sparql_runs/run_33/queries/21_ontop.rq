PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber (AVG(?policyLoss) AS ?averageLoss)
WHERE {
  {
    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber .

    ?claim a in:Claim ;
           in:against ?pcd .

    OPTIONAL {
      SELECT ?claim (SUM(?v) AS ?lossPaymentSum)
      WHERE {
        ?claim in:hasLossPayment ?lp .
        ?lp in:lossPaymentAmount ?v .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(?v) AS ?lossReserveSum)
      WHERE {
        ?claim in:hasLossReserve ?lr .
        ?lr in:lossReserveAmount ?v .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(?v) AS ?expensePaymentSum)
      WHERE {
        ?claim in:hasExpensePayment ?ep .
        ?ep in:expensePaymentAmount ?v .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(?v) AS ?expenseReserveSum)
      WHERE {
        ?claim in:hasExpenseReserve ?er .
        ?er in:expenseReserveAmount ?v .
      }
      GROUP BY ?claim
    }

    BIND(
      COALESCE(?lossPaymentSum, 0) +
      COALESCE(?lossReserveSum, 0) +
      COALESCE(?expensePaymentSum, 0) +
      COALESCE(?expenseReserveSum, 0)
      AS ?policyLoss
    )
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber