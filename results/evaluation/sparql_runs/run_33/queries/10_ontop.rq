PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policyNumber ?claimNumber ?expenseReserveAmount
WHERE {
  {
    ?policy a in:Policy ;
            in:soldByAgent ?agent ;
            in:policyNumber ?policyNumber .

    ?agent a in:Agent ;
           in:agentId ?agentId .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy .

    ?claim a in:Claim ;
           in:against ?coverage ;
           in:claimNumber ?claimNumber ;
           in:hasExpenseReserve ?expenseReserve .

    ?expenseReserve a in:ExpenseReserve ;
                    in:expenseReserveAmount ?expenseReserveAmount .
  }
}
ORDER BY ?agentId ?policyNumber ?claimNumber