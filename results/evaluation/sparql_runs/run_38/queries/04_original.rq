PREFIX in: <http://data.world/schema/insurance/>

SELECT ?catastropheName ?policyNumber
       (SUM(?lossPaymentVal + ?lossReserveVal + ?expensePaymentVal + ?expenseReserveVal) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim .

    OPTIONAL {
      ?claim in:hasCatastrophe ?cat .
      ?cat in:catastropheName ?catastropheName .
    }

    OPTIONAL {
      ?claim in:against ?pcd .
      ?pcd in:hasPolicy ?policy .
      ?policy in:policyNumber ?policyNumber .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lpAmt .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lrAmt .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?epAmt .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?erAmt .
    }

    BIND(COALESCE(xsd:decimal(?lpAmt), 0) AS ?lossPaymentVal)
    BIND(COALESCE(xsd:decimal(?lrAmt), 0) AS ?lossReserveVal)
    BIND(COALESCE(xsd:decimal(?epAmt), 0) AS ?expensePaymentVal)
    BIND(COALESCE(xsd:decimal(?erAmt), 0) AS ?expenseReserveVal)
  }
}
GROUP BY ?catastropheName ?policyNumber
ORDER BY ?catastropheName ?policyNumber