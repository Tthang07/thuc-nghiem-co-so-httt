PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber (AVG(?daysToSettle) AS ?averageTimeToSettleDays)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimOpenDate ?openDate ;
           in:claimCloseDate ?closeDate ;
           in:against ?coverage .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber .

    BIND(
      ( xsd:decimal(?closeDate - ?openDate) / 86400 ) AS ?daysToSettle
    )
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber