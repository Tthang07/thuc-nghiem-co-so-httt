PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyHolder ?policyHolderId (SUM(?amt) AS ?totalPremiumAmount)
WHERE {
  SERVICE <mapped> {
    ?policy in:hasPolicyHolder ?policyHolder .
    OPTIONAL { ?policyHolder in:policyHolderId ?policyHolderId . }

    ?coverage in:hasPolicy ?policy ;
              in:hasPremiumAmount ?premiumObj .

    ?premiumObj in:premiumAmount ?amt .
  }
}
GROUP BY ?policyHolder ?policyHolderId