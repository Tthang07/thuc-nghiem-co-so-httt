PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber (SUM(xsd:decimal(?premiumAmount)) AS ?totalPremiumAmount)
WHERE {
  SERVICE <mapped> {
    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy ;
              in:hasPremiumAmount ?premium .
    ?policy in:policyNumber ?policyNumber .
    ?premium in:premiumAmount ?premiumAmount .
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber