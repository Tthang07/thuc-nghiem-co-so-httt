PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?agentId
       (SUM(?lossAmt) AS ?totalLoss)
       (SUM(?premiumAmt) AS ?totalPremium)
       ((SUM(?lossAmt) / SUM(?premiumAmt)) AS ?lossRatio)
WHERE {
  {
    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .
    
    ?policy in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .
    
    ?agent in:agentId ?agentId .
    
    ?premium in:premiumAmount ?premiumAmt .
    
    ?claim a in:Claim ;
           in:against ?pcd ;
           in:hasLossPayment ?lossPayment .
    
    ?lossPayment in:lossPaymentAmount ?lossAmt .
  }
}
GROUP BY ?policyNumber ?agentId
ORDER BY ?policyNumber ?agentId