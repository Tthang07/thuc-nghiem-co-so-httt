PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?agentId
       (SUM(DISTINCT ?premiumVal) AS ?totalPremium)
       (SUM(DISTINCT ?lossPaymentVal) AS ?totalLossPayments)
       (SUM(DISTINCT ?expensePaymentVal) AS ?totalExpensePayments)
       (((SUM(DISTINCT ?lossPaymentVal) + SUM(DISTINCT ?expensePaymentVal)) / SUM(DISTINCT ?premiumVal)) AS ?lossRatio)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .
    ?agent in:agentId ?agentId .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .
    ?premium in:premiumAmount ?premiumVal .

    OPTIONAL {
      ?claim a in:Claim ;
             in:against ?pcd .
      OPTIONAL {
        ?claim in:hasLossPayment ?lossPayment .
        ?lossPayment in:lossPaymentAmount ?lossPaymentVal .
      }
      OPTIONAL {
        ?claim in:hasExpensePayment ?expensePayment .
        ?expensePayment in:expensePaymentAmount ?expensePaymentVal .
      }
    }
  }
}
GROUP BY ?policyNumber ?agentId
HAVING (SUM(DISTINCT ?premiumVal) > 0)
ORDER BY ?policyNumber ?agentId