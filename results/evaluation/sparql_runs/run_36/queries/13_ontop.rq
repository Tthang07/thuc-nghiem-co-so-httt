PREFIX in: <http://data.world/schema/insurance/>

SELECT ?claimNumber
       (COALESCE(SUM(?lossPaymentAmt), 0) + COALESCE(SUM(?lossReserveAmt), 0) AS ?totalLossAmount)
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber .

    OPTIONAL {
      ?claim in:hasLossPayment ?lossPayment .
      ?lossPayment in:lossPaymentAmount ?lpAmt .
      BIND(xsd:decimal(?lpAmt) AS ?lossPaymentAmt)
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lossReserve .
      ?lossReserve in:lossReserveAmount ?lrAmt .
      BIND(xsd:decimal(?lrAmt) AS ?lossReserveAmt)
    }
  }
}
GROUP BY ?claimNumber
ORDER BY ?claimNumber