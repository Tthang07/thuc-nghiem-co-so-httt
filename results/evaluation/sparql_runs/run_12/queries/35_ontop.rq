PREFIX in: <http://data.world/schema/insurance/>

SELECT DISTINCT ?policyNumber ?claimNumber
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber .
  }
}
ORDER BY ?policyNumber ?claimNumber