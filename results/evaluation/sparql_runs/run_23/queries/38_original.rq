PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?numberOfClaims (AVG(?claimLoss) AS ?averageLoss)
WHERE {
  SERVICE <mapped> {
    {
      SELECT ?policyNumber ?claim (COALESCE(?lossPaymentTotal, 0) + COALESCE(?lossReserveTotal, 0) + COALESCE(?expensePaymentTotal, 0) + COALESCE(?expenseReserveTotal, 0) AS ?claimLoss)
      WHERE {
        ?claim a in:Claim ;
               in:against ?pcd .
        ?pcd in:hasPolicy ?policy .
        ?policy in:policyNumber ?policyNumber .

        OPTIONAL {
          SELECT ?claim (SUM(?lpa) AS ?lossPaymentTotal)
          WHERE {
            ?claim in:hasLossPayment ?lp .
            ?lp in:lossPaymentAmount ?lpa .
          }
          GROUP BY ?claim
        }

        OPTIONAL {
          SELECT ?claim (SUM(?lra) AS ?lossReserveTotal)
          WHERE {
            ?claim in:hasLossReserve ?lr .
            ?lr in:lossReserveAmount ?lra .
          }
          GROUP BY ?claim
        }

        OPTIONAL {
          SELECT ?claim (SUM(?epa) AS ?expensePaymentTotal)
          WHERE {
            ?claim in:hasExpensePayment ?ep .
            ?ep in:expensePaymentAmount ?epa .
          }
          GROUP BY ?claim
        }

        OPTIONAL {
          SELECT ?claim (SUM(?era) AS ?expenseReserveTotal)
          WHERE {
            ?claim in:hasExpenseReserve ?er .
            ?er in:expenseReserveAmount ?era .
          }
          GROUP BY ?claim
        }
      }
    }
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber