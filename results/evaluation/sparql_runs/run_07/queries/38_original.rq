PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber ?numberOfClaims
       (AVG(?claimLoss) AS ?averageLoss)
WHERE {
  SERVICE <mapped> {
    {
      SELECT ?policyNumber ?claim
             ((COALESCE(SUM(DISTINCT xsd:decimal(?lossPaymentAmt)), 0) +
               COALESCE(SUM(DISTINCT xsd:decimal(?lossReserveAmt)), 0) +
               COALESCE(SUM(DISTINCT xsd:decimal(?expensePaymentAmt)), 0) +
               COALESCE(SUM(DISTINCT xsd:decimal(?expenseReserveAmt)), 0)) AS ?claimLoss)
      WHERE {
        ?claim a in:Claim ;
               in:against ?pcd .
        ?pcd in:hasPolicy ?policy .
        ?policy in:policyNumber ?policyNumber .

        OPTIONAL {
          ?claim in:hasLossPayment ?lp .
          ?lp in:lossPaymentAmount ?lossPaymentAmt .
        }
        OPTIONAL {
          ?claim in:hasLossReserve ?lr .
          ?lr in:lossReserveAmount ?lossReserveAmt .
        }
        OPTIONAL {
          ?claim in:hasExpensePayment ?ep .
          ?ep in:expensePaymentAmount ?expensePaymentAmt .
        }
        OPTIONAL {
          ?claim in:hasExpenseReserve ?er .
          ?er in:expenseReserveAmount ?expenseReserveAmt .
        }
      }
      GROUP BY ?policyNumber ?claim
    }
  }
}
GROUP BY ?policyNumber
BIND(COUNT(DISTINCT ?claim) AS ?numberOfClaims)
ORDER BY ?policyNumber