PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyHolderId (COUNT(DISTINCT ?policy) AS ?policyCount)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:hasPolicyHolder ?policyHolder .
    ?policyHolder in:policyHolderId ?policyHolderId .
  }
}
GROUP BY ?policyHolderId
ORDER BY ?policyHolderId