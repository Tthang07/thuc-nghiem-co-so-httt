PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber
       (SUM(?lossPaymentVal) AS ?totalLossPayment)
       (SUM(?lossReserveVal) AS ?totalLossReserve)
       ((SUM(?lossPaymentVal) + SUM(?lossReserveVal)) AS ?totalLossAmount)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lossPaymentAmt .
      BIND(xsd:decimal(?lossPaymentAmt) AS ?lossPaymentVal)
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lossReserveAmt .
      BIND(xsd:decimal(?lossReserveAmt) AS ?lossReserveVal)
    }
  }
}
GROUP BY ?claimNumber
ORDER BY ?claimNumber