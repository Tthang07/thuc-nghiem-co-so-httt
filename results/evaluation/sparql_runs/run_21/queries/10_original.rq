PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policyNumber ?claimNumber ?expenseReserveAmount
WHERE {
  SERVICE <mapped> {
    ?policy in:soldByAgent ?agent ;
            in:policyNumber ?policyNumber .

    ?agent in:agentId ?agentId .

    ?coverage in:hasPolicy ?policy .

    ?claim in:against ?coverage ;
           in:claimNumber ?claimNumber ;
           in:hasExpenseReserve ?expenseReserve .

    ?expenseReserve in:expenseReserveAmount ?expenseReserveAmount .
  }
}
ORDER BY ?agentId ?policyNumber ?claimNumber ?expenseReserveAmount