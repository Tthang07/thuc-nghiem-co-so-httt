PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?premiumAmount
       (COUNT(DISTINCT ?claim) AS ?numberOfClaims)
       (SUM(?claimTotalLoss) AS ?totalLoss)
       ((SUM(?claimTotalLoss) / ?premiumAmount) AS ?lossRatio)
WHERE {
  SERVICE <mapped> {
    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premiumObj .

    ?policy in:policyNumber ?policyNumber .

    ?premiumObj in:premiumAmount ?premiumAmount .

    ?claim a in:Claim ;
           in:against ?pcd .

    OPTIONAL {
      SELECT ?claim (SUM(?lpa) AS ?sumLossPayment)
      WHERE {
        ?claim in:hasLossPayment ?lp .
        ?lp in:lossPaymentAmount ?lpa .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(?lra) AS ?sumLossReserve)
      WHERE {
        ?claim in:hasLossReserve ?lr .
        ?lr in:lossReserveAmount ?lra .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(?epa) AS ?sumExpensePayment)
      WHERE {
        ?claim in:hasExpensePayment ?ep .
        ?ep in:expensePaymentAmount ?epa .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(?era) AS ?sumExpenseReserve)
      WHERE {
        ?claim in:hasExpenseReserve ?er .
        ?er in:expenseReserveAmount ?era .
      }
      GROUP BY ?claim
    }

    BIND(
      COALESCE(?sumLossPayment, 0) +
      COALESCE(?sumLossReserve, 0) +
      COALESCE(?sumExpensePayment, 0) +
      COALESCE(?sumExpenseReserve, 0)
      AS ?claimTotalLoss
    )
  }
}
GROUP BY ?policyNumber ?premiumAmount
ORDER BY ?policyNumber