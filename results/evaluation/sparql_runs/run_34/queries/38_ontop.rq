PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber ?claimCount ?averageLoss
WHERE {
  {
    {
      SELECT ?policyNumber (COUNT(DISTINCT ?claim) AS ?claimCount) (AVG(?claimLoss) AS ?averageLoss)
      WHERE {
        ?claim a in:Claim ;
               in:against ?pcd .

        ?pcd in:hasPolicy ?policy .
        ?policy in:policyNumber ?policyNumber .

        {
          SELECT ?claim
                 (COALESCE(SUM(DISTINCT xsd:decimal(?lpAmt)), 0) +
                  COALESCE(SUM(DISTINCT xsd:decimal(?lrAmt)), 0) +
                  COALESCE(SUM(DISTINCT xsd:decimal(?epAmt)), 0) +
                  COALESCE(SUM(DISTINCT xsd:decimal(?erAmt)), 0) AS ?claimLoss)
          WHERE {
            OPTIONAL {
              ?claim in:hasLossPayment ?lp .
              ?lp in:lossPaymentAmount ?lpAmt .
            }
            OPTIONAL {
              ?claim in:hasLossReserve ?lr .
              ?lr in:lossReserveAmount ?lrAmt .
            }
            OPTIONAL {
              ?claim in:hasExpensePayment ?ep .
              ?ep in:expensePaymentAmount ?epAmt .
            }
            OPTIONAL {
              ?claim in:hasExpenseReserve ?er .
              ?er in:expenseReserveAmount ?erAmt .
            }
          }
          GROUP BY ?claim
        }
      }
      GROUP BY ?policyNumber
    }
  }
}
ORDER BY ?policyNumber