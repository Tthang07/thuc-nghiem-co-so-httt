PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyHolder ?policyHolderId (SUM(xsd:decimal(?amount)) AS ?totalPremiumPaid)
WHERE {
  {
    ?policy a in:Policy ;
            in:hasPolicyHolder ?policyHolder .

    OPTIONAL { ?policyHolder in:policyHolderId ?policyHolderId . }

    ?coverageDetail a in:PolicyCoverageDetail ;
                    in:hasPolicy ?policy ;
                    in:hasPremiumAmount ?premium .

    ?premium a in:Premium ;
             in:premiumAmount ?amount .
  }
}
GROUP BY ?policyHolder ?policyHolderId