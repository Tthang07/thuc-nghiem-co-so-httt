PREFIX in: <http://data.world/schema/insurance/>

SELECT (xsd:decimal(?totalPremium) / xsd:decimal(?policyCount) AS ?averagePolicySize)
WHERE {
  {
    SELECT (SUM(?premAmt) AS ?totalPremium) (COUNT(DISTINCT ?policy) AS ?policyCount)
    WHERE {
      {
        ?pcd a in:PolicyCoverageDetail ;
             in:hasPolicy ?policy ;
             in:hasPremiumAmount ?premium .
        ?premium in:premiumAmount ?premAmt .
      }
    }
  }
}