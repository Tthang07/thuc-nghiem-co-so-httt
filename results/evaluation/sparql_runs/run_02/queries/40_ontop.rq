PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?agentId ?policy ?policyNumber
       (COALESCE(SUM(DISTINCT xsd:decimal(?lossPaymentAmt)), 0) AS ?totalLossPayment)
       (COALESCE(SUM(DISTINCT xsd:decimal(?lossReserveAmt)), 0) AS ?totalLossReserve)
       (COALESCE(SUM(DISTINCT xsd:decimal(?expensePaymentAmt)), 0) AS ?totalExpensePayment)
       (COALESCE(SUM(DISTINCT xsd:decimal(?expenseReserveAmt)), 0) AS ?totalExpenseReserve)
       ((COALESCE(SUM(DISTINCT xsd:decimal(?lossPaymentAmt)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?lossReserveAmt)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?expensePaymentAmt)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?expenseReserveAmt)), 0)) AS ?totalLoss)
WHERE {
  {
    ?policy a in:Policy ;
            in:soldByAgent ?agent .
    ?agent in:agentId ?agentId .
    
    OPTIONAL { ?policy in:policyNumber ?policyNumber . }

    OPTIONAL {
      ?coverage a in:PolicyCoverageDetail ;
                in:hasPolicy ?policy .
      ?claim a in:Claim ;
             in:against ?coverage .

      OPTIONAL {
        ?claim in:hasLossPayment ?lp .
        ?lp in:lossPaymentAmount ?lossPaymentAmt .
      }
      OPTIONAL {
        ?claim in:hasLossReserve ?lr .
        ?lr in:lossReserveAmount ?lossReserveAmt .
      }
      OPTIONAL {
        ?claim in:hasExpensePayment ?ep .
        ?ep in:expensePaymentAmount ?expensePaymentAmt .
      }
      OPTIONAL {
        ?claim in:hasExpenseReserve ?er .
        ?er in:expenseReserveAmount ?expenseReserveAmt .
      }
    }
  }
}
GROUP BY ?agentId ?policy ?policyNumber
ORDER BY ?agentId ?policyNumber ?policy