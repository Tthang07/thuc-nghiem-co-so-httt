PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber (COUNT(DISTINCT ?claim) AS ?numberOfClaims) (AVG(?claimLoss) AS ?averageLoss)
WHERE {
  SERVICE <mapped> {
    {
      SELECT ?policyNumber ?claim ?claimLoss
      WHERE {
        ?claim a in:Claim ;
               in:against ?pcd .

        ?pcd in:hasPolicy ?policy .
        ?policy in:policyNumber ?policyNumber .

        OPTIONAL {
          SELECT ?claim (SUM(?v) AS ?lossPaymentTotal)
          WHERE {
            ?claim in:hasLossPayment ?lp .
            ?lp in:lossPaymentAmount ?v .
          }
          GROUP BY ?claim
        }

        OPTIONAL {
          SELECT ?claim (SUM(?v) AS ?lossReserveTotal)
          WHERE {
            ?claim in:hasLossReserve ?lr .
            ?lr in:lossReserveAmount ?v .
          }
          GROUP BY ?claim
        }

        OPTIONAL {
          SELECT ?claim (SUM(?v) AS ?expensePaymentTotal)
          WHERE {
            ?claim in:hasExpensePayment ?ep .
            ?ep in:expensePaymentAmount ?v .
          }
          GROUP BY ?claim
        }

        OPTIONAL {
          SELECT ?claim (SUM(?v) AS ?expenseReserveTotal)
          WHERE {
            ?claim in:hasExpenseReserve ?er .
            ?er in:expenseReserveAmount ?v .
          }
          GROUP BY ?claim
        }

        BIND(
          COALESCE(?lossPaymentTotal, 0) +
          COALESCE(?lossReserveTotal, 0) +
          COALESCE(?expensePaymentTotal, 0) +
          COALESCE(?expenseReserveTotal, 0)
          AS ?claimLoss
        )
      }
    }
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber