PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policy ?policyNumber
       (COALESCE(SUM(DISTINCT ?lossPaymentAmt), 0) AS ?totalLossPayment)
       (COALESCE(SUM(DISTINCT ?lossReserveAmt), 0) AS ?totalLossReserve)
       (COALESCE(SUM(DISTINCT ?expensePaymentAmt), 0) AS ?totalExpensePayment)
       (COALESCE(SUM(DISTINCT ?expenseReserveAmt), 0) AS ?totalExpenseReserve)
       ((COALESCE(SUM(DISTINCT ?lossPaymentAmt), 0) +
         COALESCE(SUM(DISTINCT ?lossReserveAmt), 0) +
         COALESCE(SUM(DISTINCT ?expensePaymentAmt), 0) +
         COALESCE(SUM(DISTINCT ?expenseReserveAmt), 0)) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:soldByAgent ?agent ;
            in:policyNumber ?policyNumber .
    ?agent in:agentId ?agentId .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy .

    OPTIONAL {
      ?claim a in:Claim ;
             in:against ?pcd .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lossPayment .
      ?lossPayment in:lossPaymentAmount ?lossPaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lossReserve .
      ?lossReserve in:lossReserveAmount ?lossReserveAmt .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?expensePayment .
      ?expensePayment in:expensePaymentAmount ?expensePaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?expenseReserve .
      ?expenseReserve in:expenseReserveAmount ?expenseReserveAmt .
    }
  }
}
GROUP BY ?agentId ?policy ?policyNumber
ORDER BY ?agentId ?policyNumber