PREFIX in: <http://data.world/schema/insurance/>

SELECT ?claimNumber ?catastropheName ?policyNumber
       (SUM(?lossPaymentVal) AS ?totalLossPayment)
       (SUM(?lossReserveVal) AS ?totalLossReserve)
       (SUM(?expensePaymentVal) AS ?totalExpensePayment)
       (SUM(?expenseReserveVal) AS ?totalExpenseReserve)
       ((SUM(?lossPaymentVal) + SUM(?lossReserveVal) + SUM(?expensePaymentVal) + SUM(?expenseReserveVal)) AS ?totalLoss)
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber .

    OPTIONAL {
      ?claim in:hasCatastrophe ?cat .
      ?cat in:catastropheName ?catastropheName .
    }

    OPTIONAL {
      ?claim in:against ?pcd .
      ?pcd in:hasPolicy ?policy .
      ?policy in:policyNumber ?policyNumber .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lpAmt .
      BIND(xsd:decimal(?lpAmt) AS ?lossPaymentVal)
    }
    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lrAmt .
      BIND(xsd:decimal(?lrAmt) AS ?lossReserveVal)
    }
    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?epAmt .
      BIND(xsd:decimal(?epAmt) AS ?expensePaymentVal)
    }
    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?erAmt .
      BIND(xsd:decimal(?erAmt) AS ?expenseReserveVal)
    }

    BIND(COALESCE(?lossPaymentVal, 0) AS ?lossPaymentVal)
    BIND(COALESCE(?lossReserveVal, 0) AS ?lossReserveVal)
    BIND(COALESCE(?expensePaymentVal, 0) AS ?expensePaymentVal)
    BIND(COALESCE(?expenseReserveVal, 0) AS ?expenseReserveVal)
  }
}
GROUP BY ?claimNumber ?catastropheName ?policyNumber
ORDER BY ?claimNumber ?catastropheName ?policyNumber