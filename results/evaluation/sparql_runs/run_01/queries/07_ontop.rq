PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
       (COALESCE(SUM(xsd:decimal(?lossPaymentAmt)), 0) AS ?totalLossPayment)
       (COALESCE(SUM(xsd:decimal(?lossReserveAmt)), 0) AS ?totalLossReserve)
       (COALESCE(SUM(xsd:decimal(?expensePaymentAmt)), 0) AS ?totalExpensePayment)
       (COALESCE(SUM(xsd:decimal(?expenseReserveAmt)), 0) AS ?totalExpenseReserve)
       ((COALESCE(SUM(xsd:decimal(?lossPaymentAmt)), 0) +
         COALESCE(SUM(xsd:decimal(?lossReserveAmt)), 0) +
         COALESCE(SUM(xsd:decimal(?expensePaymentAmt)), 0) +
         COALESCE(SUM(xsd:decimal(?expenseReserveAmt)), 0)) AS ?totalLoss)
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolder .

    ?policyHolder a in:PolicyHolder ;
                  in:policyHolderId ?policyHolderId .

    ?premium a in:Premium ;
             in:premiumAmount ?premiumAmount .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp a in:LossPayment ;
          in:lossPaymentAmount ?lossPaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr a in:LossReserve ;
          in:lossReserveAmount ?lossReserveAmt .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep a in:ExpensePayment ;
          in:expensePaymentAmount ?expensePaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er a in:ExpenseReserve ;
          in:expenseReserveAmount ?expenseReserveAmt .
    }
  }
}
GROUP BY ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
ORDER BY ?claimNumber