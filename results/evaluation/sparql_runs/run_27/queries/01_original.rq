PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?agentId
       (SUM(COALESCE(?lossPaymentVal, 0) + COALESCE(?lossReserveVal, 0)) AS ?totalLoss)
       (SUM(COALESCE(?premiumVal, 0)) AS ?totalPremium)
       ((SUM(COALESCE(?lossPaymentVal, 0) + COALESCE(?lossReserveVal, 0)) / SUM(COALESCE(?premiumVal, 0))) AS ?lossRatio)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .

    ?agent a in:Agent ;
           in:agentId ?agentId .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .

    ?premium a in:Premium ;
             in:premiumAmount ?premiumVal .

    OPTIONAL {
      ?claim a in:Claim ;
             in:against ?pcd .
      OPTIONAL {
        ?claim in:hasLossPayment ?lp .
        ?lp a in:LossPayment ;
            in:lossPaymentAmount ?lossPaymentVal .
      }
      OPTIONAL {
        ?claim in:hasLossReserve ?lr .
        ?lr a in:LossReserve ;
            in:lossReserveAmount ?lossReserveVal .
      }
    }
  }
}
GROUP BY ?policyNumber ?agentId
HAVING (SUM(COALESCE(?premiumVal, 0)) > 0)