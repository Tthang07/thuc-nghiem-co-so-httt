PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber ?agentId
       (SUM(?lossVal) AS ?totalLoss)
       (SUM(?premiumVal) AS ?totalPremium)
       ((SUM(?lossVal) / SUM(?premiumVal)) AS ?lossRatio)
WHERE {
  {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .

    ?agent a in:Agent ;
           in:agentId ?agentId .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premiumObj .

    ?premiumObj a in:Premium ;
                in:premiumAmount ?premiumAmt .

    OPTIONAL {
      ?claim a in:Claim ;
             in:against ?pcd ;
             in:hasLossPayment ?lossPayment .
      ?lossPayment a in:LossPayment ;
                   in:lossPaymentAmount ?lossPaymentAmt .
    }

    OPTIONAL {
      ?claim2 a in:Claim ;
              in:against ?pcd ;
              in:hasLossReserve ?lossReserve .
      ?lossReserve a in:LossReserve ;
                   in:lossReserveAmount ?lossReserveAmt .
    }

    BIND(xsd:decimal(?premiumAmt) AS ?premiumVal)
    BIND(xsd:decimal(COALESCE(?lossPaymentAmt, 0)) + xsd:decimal(COALESCE(?lossReserveAmt, 0)) AS ?lossVal)
  }
}
GROUP BY ?policyNumber ?agentId
HAVING (SUM(?premiumVal) > 0)
ORDER BY ?policyNumber ?agentId