PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?effectiveDate ?expirationDate
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber .
    OPTIONAL { ?policy in:policyEffectiveDate ?effectiveDate . }
    OPTIONAL { ?policy in:policyExpirationDate ?expirationDate . }
  }
}