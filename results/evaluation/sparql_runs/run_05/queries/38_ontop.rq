PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber ?numberOfClaims ?averageLoss
WHERE {
  {
    {
      SELECT ?policyNumber
             (COUNT(DISTINCT ?claim) AS ?numberOfClaims)
             (AVG(?claimLoss) AS ?averageLoss)
      WHERE {
        ?claim a in:Claim ;
               in:against ?pcd .

        ?pcd in:hasPolicy ?policy .
        ?policy in:policyNumber ?policyNumber .

        {
          SELECT ?claim
                 ((COALESCE(SUM(DISTINCT ?lpAmt), 0) +
                   COALESCE(SUM(DISTINCT ?lrAmt), 0) +
                   COALESCE(SUM(DISTINCT ?epAmt), 0) +
                   COALESCE(SUM(DISTINCT ?erAmt), 0)) AS ?claimLoss)
          WHERE {
            OPTIONAL {
              ?claim in:hasLossPayment ?lp .
              ?lp in:lossPaymentAmount ?lpAmt .
            }
            OPTIONAL {
              ?claim in:hasLossReserve ?lr .
              ?lr in:lossReserveAmount ?lrAmt .
            }
            OPTIONAL {
              ?claim in:hasExpensePayment ?ep .
              ?ep in:expensePaymentAmount ?epAmt .
            }
            OPTIONAL {
              ?claim in:hasExpenseReserve ?er .
              ?er in:expenseReserveAmount ?erAmt .
            }
          }
          GROUP BY ?claim
        }
      }
      GROUP BY ?policyNumber
    }
  }
}
ORDER BY ?policyNumber