PREFIX in: <http://data.world/schema/insurance/>

SELECT (xsd:decimal(SUM(?premiumValue)) / COUNT(DISTINCT ?policy) AS ?averagePolicySize)
WHERE {
  {
    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .
    ?premium in:premiumAmount ?premiumValue .
  }
}