PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?agentId ?policy ?policyNumber
       (COALESCE(SUM(DISTINCT xsd:decimal(?lossPaymentAmount)), 0) +
        COALESCE(SUM(DISTINCT xsd:decimal(?lossReserveAmount)), 0) +
        COALESCE(SUM(DISTINCT xsd:decimal(?expensePaymentAmount)), 0) +
        COALESCE(SUM(DISTINCT xsd:decimal(?expenseReserveAmount)), 0) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:soldByAgent ?agent .

    ?agent in:agentId ?agentId .

    OPTIONAL { ?policy in:policyNumber ?policyNumber . }

    OPTIONAL {
      ?pcd a in:PolicyCoverageDetail ;
           in:hasPolicy ?policy .
      ?claim a in:Claim ;
             in:against ?pcd .

      OPTIONAL {
        ?claim in:hasLossPayment ?lp .
        ?lp in:lossPaymentAmount ?lossPaymentAmount .
      }
      OPTIONAL {
        ?claim in:hasLossReserve ?lr .
        ?lr in:lossReserveAmount ?lossReserveAmount .
      }
      OPTIONAL {
        ?claim in:hasExpensePayment ?ep .
        ?ep in:expensePaymentAmount ?expensePaymentAmount .
      }
      OPTIONAL {
        ?claim in:hasExpenseReserve ?er .
        ?er in:expenseReserveAmount ?expenseReserveAmount .
      }
    }
  }
}
GROUP BY ?agentId ?policy ?policyNumber
ORDER BY ?agentId ?policyNumber ?policy