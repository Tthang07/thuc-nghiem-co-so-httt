PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber ?catastropheName ?policyNumber
       (SUM(?lossPaymentVal + ?lossReserveVal + ?expensePaymentVal + ?expenseReserveVal) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    OPTIONAL {
      ?claim in:hasCatastrophe ?cat .
      OPTIONAL { ?cat in:catastropheName ?catastropheName . }
    }

    ?pcd in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lossPaymentAmtRaw .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lossReserveAmtRaw .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?expensePaymentAmtRaw .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?expenseReserveAmtRaw .
    }

    BIND(COALESCE(xsd:decimal(?lossPaymentAmtRaw), 0) AS ?lossPaymentVal)
    BIND(COALESCE(xsd:decimal(?lossReserveAmtRaw), 0) AS ?lossReserveVal)
    BIND(COALESCE(xsd:decimal(?expensePaymentAmtRaw), 0) AS ?expensePaymentVal)
    BIND(COALESCE(xsd:decimal(?expenseReserveAmtRaw), 0) AS ?expenseReserveVal)
  }
}
GROUP BY ?claimNumber ?catastropheName ?policyNumber
ORDER BY ?claimNumber ?catastropheName ?policyNumber