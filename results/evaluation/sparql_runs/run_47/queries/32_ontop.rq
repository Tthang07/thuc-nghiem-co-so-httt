PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policyNumber ?claimNumber ?lossPaymentAmount
WHERE {
  {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .

    ?agent a in:Agent ;
           in:agentId ?agentId .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy .

    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?coverage ;
           in:hasLossPayment ?lossPayment .

    ?lossPayment a in:LossPayment ;
                 in:lossPaymentAmount ?lossPaymentAmount .
  }
}
ORDER BY ?agentId ?policyNumber ?claimNumber ?lossPaymentAmount