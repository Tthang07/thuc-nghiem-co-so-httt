PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber (COUNT(DISTINCT ?claim) AS ?numberOfClaims) (AVG(?claimLoss) AS ?averageLoss)
WHERE {
  {
    ?claim a in:Claim ;
           in:against ?pcd .

    ?pcd in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber .

    {
      SELECT ?claim
             (COALESCE(SUM(DISTINCT ?lossPaymentAmt), 0) AS ?sumLossPayment)
             (COALESCE(SUM(DISTINCT ?lossReserveAmt), 0) AS ?sumLossReserve)
             (COALESCE(SUM(DISTINCT ?expensePaymentAmt), 0) AS ?sumExpensePayment)
             (COALESCE(SUM(DISTINCT ?expenseReserveAmt), 0) AS ?sumExpenseReserve)
      WHERE {
        OPTIONAL {
          ?claim in:hasLossPayment ?lp .
          ?lp in:lossPaymentAmount ?lossPaymentAmt .
        }
        OPTIONAL {
          ?claim in:hasLossReserve ?lr .
          ?lr in:lossReserveAmount ?lossReserveAmt .
        }
        OPTIONAL {
          ?claim in:hasExpensePayment ?ep .
          ?ep in:expensePaymentAmount ?expensePaymentAmt .
        }
        OPTIONAL {
          ?claim in:hasExpenseReserve ?er .
          ?er in:expenseReserveAmount ?expenseReserveAmt .
        }
      }
      GROUP BY ?claim
    }

    BIND((?sumLossPayment + ?sumLossReserve + ?sumExpensePayment + ?sumExpenseReserve) AS ?claimLoss)
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber