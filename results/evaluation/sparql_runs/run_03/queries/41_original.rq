PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber ?catastropheName ?policyNumber
       (COALESCE(SUM(xsd:decimal(?lossPaymentAmt)), 0) +
        COALESCE(SUM(xsd:decimal(?lossReserveAmt)), 0) +
        COALESCE(SUM(xsd:decimal(?expensePaymentAmt)), 0) +
        COALESCE(SUM(xsd:decimal(?expenseReserveAmt)), 0) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    ?pcd in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber .

    OPTIONAL {
      ?claim in:hasCatastrophe ?cat .
      ?cat in:catastropheName ?catastropheName .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lossPaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lossReserveAmt .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?expensePaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?expenseReserveAmt .
    }
  }
}
GROUP BY ?claimNumber ?catastropheName ?policyNumber
ORDER BY ?claimNumber ?catastropheName ?policyNumber