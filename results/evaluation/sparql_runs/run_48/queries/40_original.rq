PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?agentId ?policyNumber
       (COALESCE(SUM(DISTINCT xsd:decimal(?lpAmt)), 0) AS ?totalLossPayment)
       (COALESCE(SUM(DISTINCT xsd:decimal(?lrAmt)), 0) AS ?totalLossReserve)
       (COALESCE(SUM(DISTINCT xsd:decimal(?epAmt)), 0) AS ?totalExpensePayment)
       (COALESCE(SUM(DISTINCT xsd:decimal(?erAmt)), 0) AS ?totalExpenseReserve)
       ((COALESCE(SUM(DISTINCT xsd:decimal(?lpAmt)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?lrAmt)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?epAmt)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?erAmt)), 0)) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?policy in:soldByAgent ?agent ;
            in:policyNumber ?policyNumber .
    ?agent in:agentId ?agentId .

    ?pcd in:hasPolicy ?policy .
    ?claim in:against ?pcd .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lpAmt .
    }
    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lrAmt .
    }
    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?epAmt .
    }
    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?erAmt .
    }
  }
}
GROUP BY ?agentId ?policyNumber
ORDER BY ?agentId ?policyNumber