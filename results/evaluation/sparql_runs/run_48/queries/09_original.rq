PREFIX in: <http://data.world/schema/insurance/>

SELECT ?claimNumber ?policyNumber ?policyHolder ?premiumAmountPaid ?catastrophe ?agent
       ?lossPaymentAmount ?lossReserveAmount ?expensePaymentAmount ?expenseReserveAmount
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    ?pcd in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .

    ?policy in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolderRes ;
            in:soldByAgent ?agentRes .

    OPTIONAL { ?premium in:premiumAmount ?premiumAmountPaid . }
    OPTIONAL { ?claim in:hasCatastrophe ?catRes . }
    OPTIONAL { ?catRes in:catastropheName ?catastrophe . }
    OPTIONAL { ?policyHolderRes in:policyHolderId ?policyHolder . }
    OPTIONAL { ?agentRes in:agentId ?agent . }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lossPaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lossReserveAmount .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?expensePaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?expenseReserveAmount .
    }
  }
}