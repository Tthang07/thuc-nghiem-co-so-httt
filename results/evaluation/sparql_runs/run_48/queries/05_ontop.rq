PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policyNumber ?claimNumber ?expensePaymentAmount
WHERE {
  {
    ?policy a in:Policy ;
            in:soldByAgent ?agent ;
            in:policyNumber ?policyNumber .

    ?agent a in:Agent ;
           in:agentId ?agentId .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy .

    ?claim a in:Claim ;
           in:against ?pcd ;
           in:claimNumber ?claimNumber ;
           in:hasExpensePayment ?expensePayment .

    ?expensePayment a in:ExpensePayment ;
                    in:expensePaymentAmount ?expensePaymentAmount .
  }
}
ORDER BY ?agentId ?policyNumber ?claimNumber