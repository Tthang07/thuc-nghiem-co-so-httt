PREFIX in: <http://data.world/schema/insurance/>

SELECT ?claimNumber ?policyNumber ?policyHolderId ?premiumAmountPaid
       ?lossPaymentAmount ?lossReserveAmount ?expensePaymentAmount ?expenseReserveAmount
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?coverage .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy ;
              in:hasPremiumAmount ?premium .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolder .

    ?policyHolder a in:PolicyHolder ;
                  in:policyHolderId ?policyHolderId .

    ?premium a in:Premium ;
             in:premiumAmount ?premiumAmountPaid .

    OPTIONAL {
      ?claim in:hasLossPayment ?lossPayment .
      ?lossPayment a in:LossPayment ;
                   in:lossPaymentAmount ?lossPaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lossReserve .
      ?lossReserve a in:LossReserve ;
                   in:lossReserveAmount ?lossReserveAmount .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?expensePayment .
      ?expensePayment a in:ExpensePayment ;
                      in:expensePaymentAmount ?expensePaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?expenseReserve .
      ?expenseReserve a in:ExpenseReserve ;
                      in:expenseReserveAmount ?expenseReserveAmount .
    }
  }
}
ORDER BY ?claimNumber ?policyNumber