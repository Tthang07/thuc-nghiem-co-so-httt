PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policy ?policyNumber
       (COALESCE(SUM(DISTINCT ?lossPaymentAmt), 0) +
        COALESCE(SUM(DISTINCT ?lossReserveAmt), 0) +
        COALESCE(SUM(DISTINCT ?expensePaymentAmt), 0) +
        COALESCE(SUM(DISTINCT ?expenseReserveAmt), 0) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:soldByAgent ?agent .
    ?agent in:agentId ?agentId .
    
    OPTIONAL { ?policy in:policyNumber ?policyNumber . }

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy .

    ?claim a in:Claim ;
           in:against ?coverage .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lpAmt .
      BIND(xsd:decimal(?lpAmt) AS ?lossPaymentAmt)
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lrAmt .
      BIND(xsd:decimal(?lrAmt) AS ?lossReserveAmt)
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?epAmt .
      BIND(xsd:decimal(?epAmt) AS ?expensePaymentAmt)
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?erAmt .
      BIND(xsd:decimal(?erAmt) AS ?expenseReserveAmt)
    }
  }
}
GROUP BY ?agentId ?policy ?policyNumber
ORDER BY ?agentId ?policyNumber ?policy