PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber (AVG(?policyLoss) AS ?averageLoss)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:against ?pcd .

    ?pcd in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lossPaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lossReserveAmount .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?expensePaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?expenseReserveAmount .
    }

    BIND(
      COALESCE(xsd:decimal(?lossPaymentAmount), 0) +
      COALESCE(xsd:decimal(?lossReserveAmount), 0) +
      COALESCE(xsd:decimal(?expensePaymentAmount), 0) +
      COALESCE(xsd:decimal(?expenseReserveAmount), 0)
      AS ?policyLoss
    )
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber