PREFIX in: <http://data.world/schema/insurance/>

SELECT DISTINCT ?policyHolder ?claim ?catastrophe
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:hasCatastrophe ?catastrophe ;
           in:against ?policyCoverageDetail .

    ?policyCoverageDetail a in:PolicyCoverageDetail ;
                          in:hasPolicy ?policy .

    ?policy a in:Policy ;
            in:hasPolicyHolder ?policyHolder .
  }
}