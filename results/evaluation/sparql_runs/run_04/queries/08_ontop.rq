PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyHolder ?policyNumber (SUM(?amount) AS ?totalPremiumAmount)
WHERE {
  {
    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolder .

    ?premium a in:Premium ;
             in:premiumAmount ?amount .
  }
}
GROUP BY ?policyHolder ?policyNumber
ORDER BY ?policyHolder ?policyNumber