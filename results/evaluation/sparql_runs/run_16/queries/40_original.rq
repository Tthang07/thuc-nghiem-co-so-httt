PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policy ?policyNumber
       (SUM(?lossPaymentVal + ?lossReserveVal + ?expensePaymentVal + ?expenseReserveVal) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:soldByAgent ?agent .
    ?agent in:agentId ?agentId .

    OPTIONAL { ?policy in:policyNumber ?policyNumber . }

    ?coverage in:hasPolicy ?policy .
    ?claim in:against ?coverage .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lossPaymentAmt .
    }
    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lossReserveAmt .
    }
    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?expensePaymentAmt .
    }
    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?expenseReserveAmt .
    }

    BIND(COALESCE(xsd:decimal(?lossPaymentAmt), 0) AS ?lossPaymentVal)
    BIND(COALESCE(xsd:decimal(?lossReserveAmt), 0) AS ?lossReserveVal)
    BIND(COALESCE(xsd:decimal(?expensePaymentAmt), 0) AS ?expensePaymentVal)
    BIND(COALESCE(xsd:decimal(?expenseReserveAmt), 0) AS ?expenseReserveVal)
  }
}
GROUP BY ?agentId ?policy ?policyNumber
ORDER BY ?agentId ?policyNumber ?policy