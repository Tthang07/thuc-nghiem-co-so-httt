PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
       (SUM(?lossPaymentVal + ?lossReserveVal + ?expensePaymentVal + ?expenseReserveVal) AS ?totalLoss)
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolder .

    ?policyHolder a in:PolicyHolder ;
                  in:policyHolderId ?policyHolderId .

    OPTIONAL {
      ?pcd in:hasPremiumAmount ?premium .
      ?premium a in:Premium ;
               in:premiumAmount ?premiumAmount .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp a in:LossPayment ;
          in:lossPaymentAmount ?lpAmtRaw .
      BIND(xsd:decimal(?lpAmtRaw) AS ?lossPaymentVal)
    }
    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr a in:LossReserve ;
          in:lossReserveAmount ?lrAmtRaw .
      BIND(xsd:decimal(?lrAmtRaw) AS ?lossReserveVal)
    }
    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep a in:ExpensePayment ;
          in:expensePaymentAmount ?epAmtRaw .
      BIND(xsd:decimal(?epAmtRaw) AS ?expensePaymentVal)
    }
    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er a in:ExpenseReserve ;
          in:expenseReserveAmount ?erAmtRaw .
      BIND(xsd:decimal(?erAmtRaw) AS ?expenseReserveVal)
    }

    BIND(COALESCE(?lossPaymentVal, 0) AS ?lossPaymentVal)
    BIND(COALESCE(?lossReserveVal, 0) AS ?lossReserveVal)
    BIND(COALESCE(?expensePaymentVal, 0) AS ?expensePaymentVal)
    BIND(COALESCE(?expenseReserveVal, 0) AS ?expenseReserveVal)
  }
}
GROUP BY ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
ORDER BY ?claimNumber ?policyNumber