PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyHolderId ?policyNumber (SUM(?amount) AS ?totalPremiumPaid)
WHERE {
  SERVICE <mapped> {
    ?coverage in:hasPolicy ?policy ;
              in:hasPremiumAmount ?premium .
    ?policy in:hasPolicyHolder ?policyHolder ;
            in:policyNumber ?policyNumber .
    ?policyHolder in:policyHolderId ?policyHolderId .
    ?premium in:premiumAmount ?amount .
  }
}
GROUP BY ?policyHolderId ?policyNumber
ORDER BY ?policyHolderId ?policyNumber