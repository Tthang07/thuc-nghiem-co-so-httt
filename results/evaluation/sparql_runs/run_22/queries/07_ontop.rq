PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber ?policyNumber ?policyHolder ?premiumAmount
       (COALESCE(SUM(?lossPaymentVal), 0) +
        COALESCE(SUM(?lossReserveVal), 0) +
        COALESCE(SUM(?expensePaymentVal), 0) +
        COALESCE(SUM(?expenseReserveVal), 0) AS ?totalLoss)
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?coverage .

    ?coverage in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?ph .
    ?ph in:policyHolderId ?policyHolder .

    OPTIONAL {
      ?coverage in:hasPremiumAmount ?premium .
      ?premium in:premiumAmount ?premiumAmount .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lpAmt .
      BIND(xsd:decimal(?lpAmt) AS ?lossPaymentVal)
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lrAmt .
      BIND(xsd:decimal(?lrAmt) AS ?lossReserveVal)
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?epAmt .
      BIND(xsd:decimal(?epAmt) AS ?expensePaymentVal)
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?erAmt .
      BIND(xsd:decimal(?erAmt) AS ?expenseReserveVal)
    }
  }
}
GROUP BY ?claimNumber ?policyNumber ?policyHolder ?premiumAmount
ORDER BY ?claimNumber