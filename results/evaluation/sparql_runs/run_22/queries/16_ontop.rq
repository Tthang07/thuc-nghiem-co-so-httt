PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policyNumber ?claimNumber ?lossReserveAmount
WHERE {
  {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .

    ?agent a in:Agent ;
           in:agentId ?agentId .

    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?coverage ;
           in:hasLossReserve ?lossReserve .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy .

    ?lossReserve a in:LossReserve ;
                 in:lossReserveAmount ?lossReserveAmount .
  }
}
ORDER BY ?agentId ?policyNumber ?claimNumber