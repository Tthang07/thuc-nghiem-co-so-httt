PREFIX in: <http://data.world/schema/insurance/>

SELECT DISTINCT ?agent ?policy ?claim ?catastrophe
WHERE {
  {
    ?policy a in:Policy ;
            in:soldByAgent ?agent .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy .

    ?claim a in:Claim ;
           in:against ?pcd ;
           in:hasCatastrophe ?catastrophe .
  }
}