PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?numberOfClaims (AVG(?claimLoss) AS ?averageLoss)
WHERE {
  {
    SELECT ?policyNumber ?claim (COUNT(DISTINCT ?claim) AS ?numberOfClaims) ?claimLoss
    WHERE {
      {
        ?claim a in:Claim ;
               in:against ?pcd .

        ?pcd in:hasPolicy ?policy .
        ?policy in:policyNumber ?policyNumber .

        OPTIONAL {
          ?claim in:hasLossPayment ?lp .
          ?lp in:lossPaymentAmount ?lpa .
        }
        OPTIONAL {
          ?claim in:hasLossReserve ?lr .
          ?lr in:lossReserveAmount ?lra .
        }
        OPTIONAL {
          ?claim in:hasExpensePayment ?ep .
          ?ep in:expensePaymentAmount ?epa .
        }
        OPTIONAL {
          ?claim in:hasExpenseReserve ?er .
          ?er in:expenseReserveAmount ?era .
        }
      }
      BIND(COALESCE(xsd:decimal(?lpa), 0) +
           COALESCE(xsd:decimal(?lra), 0) +
           COALESCE(xsd:decimal(?epa), 0) +
           COALESCE(xsd:decimal(?era), 0) AS ?claimLoss)
    }
    GROUP BY ?policyNumber ?claim ?claimLoss
  }
}
GROUP BY ?policyNumber ?numberOfClaims
ORDER BY ?policyNumber