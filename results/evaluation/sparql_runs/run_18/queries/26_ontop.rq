PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber ?premiumAmount
       (COUNT(DISTINCT ?claim) AS ?numberOfClaims)
       (SUM(?claimTotalLoss) AS ?totalLoss)
       ((SUM(?claimTotalLoss) / xsd:decimal(?premiumAmount)) AS ?lossRatio)
WHERE {
  {
    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .

    ?policy in:policyNumber ?policyNumber .

    ?premium in:premiumAmount ?premiumAmount .

    ?claim a in:Claim ;
           in:against ?pcd .

    OPTIONAL {
      SELECT ?claim (SUM(xsd:decimal(?lpa)) AS ?sumLossPayment)
      WHERE {
        ?claim in:hasLossPayment ?lp .
        ?lp in:lossPaymentAmount ?lpa .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(xsd:decimal(?lra)) AS ?sumLossReserve)
      WHERE {
        ?claim in:hasLossReserve ?lr .
        ?lr in:lossReserveAmount ?lra .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(xsd:decimal(?epa)) AS ?sumExpensePayment)
      WHERE {
        ?claim in:hasExpensePayment ?ep .
        ?ep in:expensePaymentAmount ?epa .
      }
      GROUP BY ?claim
    }

    OPTIONAL {
      SELECT ?claim (SUM(xsd:decimal(?era)) AS ?sumExpenseReserve)
      WHERE {
        ?claim in:hasExpenseReserve ?er .
        ?er in:expenseReserveAmount ?era .
      }
      GROUP BY ?claim
    }

    BIND(
      COALESCE(?sumLossPayment, 0) +
      COALESCE(?sumLossReserve, 0) +
      COALESCE(?sumExpensePayment, 0) +
      COALESCE(?sumExpenseReserve, 0)
      AS ?claimTotalLoss
    )
  }
}
GROUP BY ?policyNumber ?premiumAmount
ORDER BY ?policyNumber