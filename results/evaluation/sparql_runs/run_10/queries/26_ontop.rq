PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber ?premiumAmount
       (COUNT(DISTINCT ?claim) AS ?numberOfClaims)
       (SUM(?lossComponent) AS ?totalLoss)
       (IF(xsd:decimal(?premiumAmount) != 0,
           SUM(?lossComponent) / xsd:decimal(?premiumAmount),
           0) AS ?lossRatio)
WHERE {
  {
    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premiumObj .

    ?policy in:policyNumber ?policyNumber .

    ?premiumObj in:premiumAmount ?premiumAmount .

    ?claim a in:Claim ;
           in:against ?pcd .

    {
      SELECT ?claim (SUM(?amt) AS ?lossComponent)
      WHERE {
        {
          ?claim in:hasLossPayment ?lp .
          ?lp in:lossPaymentAmount ?rawAmt .
          BIND(xsd:decimal(?rawAmt) AS ?amt)
        }
        UNION
        {
          ?claim in:hasLossReserve ?lr .
          ?lr in:lossReserveAmount ?rawAmt .
          BIND(xsd:decimal(?rawAmt) AS ?amt)
        }
        UNION
        {
          ?claim in:hasExpensePayment ?ep .
          ?ep in:expensePaymentAmount ?rawAmt .
          BIND(xsd:decimal(?rawAmt) AS ?amt)
        }
        UNION
        {
          ?claim in:hasExpenseReserve ?er .
          ?er in:expenseReserveAmount ?rawAmt .
          BIND(xsd:decimal(?rawAmt) AS ?amt)
        }
      }
      GROUP BY ?claim
    }
  }
}
GROUP BY ?policyNumber ?premiumAmount
ORDER BY ?policyNumber