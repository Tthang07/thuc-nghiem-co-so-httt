PREFIX in: <http://data.world/schema/insurance/>

SELECT ?claimNumber ?policyNumber ?policyHolder ?premiumAmount ?agent
       ?lossPaymentAmount ?lossReserveAmount ?expensePaymentAmount ?expenseReserveAmount
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy ;
         in:hasPremiumAmount ?premium .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolder ;
            in:soldByAgent ?agent .

    ?premium a in:Premium ;
             in:premiumAmount ?premiumAmount .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp a in:LossPayment ;
          in:lossPaymentAmount ?lossPaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr a in:LossReserve ;
          in:lossReserveAmount ?lossReserveAmount .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep a in:ExpensePayment ;
          in:expensePaymentAmount ?expensePaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er a in:ExpenseReserve ;
          in:expenseReserveAmount ?expenseReserveAmount .
    }
  }
}