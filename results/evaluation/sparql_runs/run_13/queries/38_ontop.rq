PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policyNumber ?claimCount ?averageLoss
WHERE {
  {
    {
      SELECT ?policyNumber (COUNT(DISTINCT ?claim) AS ?claimCount) (AVG(?claimLoss) AS ?averageLoss)
      WHERE {
        ?claim a in:Claim ;
               in:against ?pcd .

        ?pcd in:hasPolicy ?policy .
        ?policy in:policyNumber ?policyNumber .

        {
          SELECT ?claim
                 (COALESCE(SUM(xsd:decimal(?lpa)), 0) AS ?sumLossPayment)
                 (COALESCE(SUM(xsd:decimal(?lra)), 0) AS ?sumLossReserve)
                 (COALESCE(SUM(xsd:decimal(?epa)), 0) AS ?sumExpensePayment)
                 (COALESCE(SUM(xsd:decimal(?era)), 0) AS ?sumExpenseReserve)
                 ((COALESCE(SUM(xsd:decimal(?lpa)), 0) +
                   COALESCE(SUM(xsd:decimal(?lra)), 0) +
                   COALESCE(SUM(xsd:decimal(?epa)), 0) +
                   COALESCE(SUM(xsd:decimal(?era)), 0)) AS ?claimLoss)
          WHERE {
            ?claim a in:Claim .

            OPTIONAL {
              ?claim in:hasLossPayment ?lp .
              ?lp in:lossPaymentAmount ?lpa .
            }
            OPTIONAL {
              ?claim in:hasLossReserve ?lr .
              ?lr in:lossReserveAmount ?lra .
            }
            OPTIONAL {
              ?claim in:hasExpensePayment ?ep .
              ?ep in:expensePaymentAmount ?epa .
            }
            OPTIONAL {
              ?claim in:hasExpenseReserve ?er .
              ?er in:expenseReserveAmount ?era .
            }
          }
          GROUP BY ?claim
        }
      }
      GROUP BY ?policyNumber
    }
  }
}
ORDER BY ?policyNumber