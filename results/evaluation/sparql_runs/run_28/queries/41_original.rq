PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber ?catastropheName ?policyNumber
       (SUM(xsd:decimal(?lossPaymentVal)) AS ?totalLossPayment)
       (SUM(xsd:decimal(?lossReserveVal)) AS ?totalLossReserve)
       (SUM(xsd:decimal(?expensePaymentVal)) AS ?totalExpensePayment)
       (SUM(xsd:decimal(?expenseReserveVal)) AS ?totalExpenseReserve)
       ((SUM(xsd:decimal(?lossPaymentVal)) +
         SUM(xsd:decimal(?lossReserveVal)) +
         SUM(xsd:decimal(?expensePaymentVal)) +
         SUM(xsd:decimal(?expenseReserveVal))) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber .

    OPTIONAL {
      ?claim in:hasCatastrophe ?cat .
      ?cat in:catastropheName ?catastropheName .
    }

    OPTIONAL {
      ?claim in:against ?pcd .
      ?pcd in:hasPolicy ?policy .
      ?policy in:policyNumber ?policyNumber .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lossPaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lossReserveAmt .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?expensePaymentAmt .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?expenseReserveAmt .
    }

    BIND(COALESCE(?lossPaymentAmt, 0) AS ?lossPaymentVal)
    BIND(COALESCE(?lossReserveAmt, 0) AS ?lossReserveVal)
    BIND(COALESCE(?expensePaymentAmt, 0) AS ?expensePaymentVal)
    BIND(COALESCE(?expenseReserveAmt, 0) AS ?expenseReserveVal)
  }
}
GROUP BY ?claimNumber ?catastropheName ?policyNumber
ORDER BY ?claimNumber ?catastropheName ?policyNumber