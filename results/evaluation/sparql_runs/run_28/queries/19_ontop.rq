PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber
       (SUM(?amount) AS ?totalLoss)
WHERE {
  {
    ?claim a in:Claim ;
           in:against ?pcd .

    ?pcd in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber .

    {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?rawAmount .
    }
    UNION
    {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?rawAmount .
    }
    UNION
    {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?rawAmount .
    }
    UNION
    {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?rawAmount .
    }

    BIND(xsd:decimal(?rawAmount) AS ?amount)
  }
}
GROUP BY ?policyNumber
ORDER BY ?policyNumber