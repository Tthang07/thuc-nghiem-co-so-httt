PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?agentId
       (SUM(COALESCE(?lossPaid, 0) + COALESCE(?lossReserved, 0)) AS ?totalLoss)
       (SUM(COALESCE(?premiumValue, 0)) AS ?totalPremium)
       ((SUM(COALESCE(?lossPaid, 0) + COALESCE(?lossReserved, 0))) / SUM(COALESCE(?premiumValue, 0)) AS ?lossRatio)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .

    ?agent a in:Agent ;
           in:agentId ?agentId .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy ;
              in:hasPremiumAmount ?premium .

    ?premium a in:Premium ;
             in:premiumAmount ?premiumValue .

    OPTIONAL {
      ?claim a in:Claim ;
             in:against ?coverage .
      OPTIONAL {
        ?claim in:hasLossPayment ?lp .
        ?lp a in:LossPayment ;
            in:lossPaymentAmount ?lossPaid .
      }
      OPTIONAL {
        ?claim in:hasLossReserve ?lr .
        ?lr a in:LossReserve ;
            in:lossReserveAmount ?lossReserved .
      }
    }
  }
}
GROUP BY ?policyNumber ?agentId
HAVING (SUM(COALESCE(?premiumValue, 0)) > 0)
ORDER BY ?policyNumber ?agentId