PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
       (COALESCE(SUM(DISTINCT xsd:decimal(?lossPaymentAmount)), 0) +
        COALESCE(SUM(DISTINCT xsd:decimal(?lossReserveAmount)), 0) +
        COALESCE(SUM(DISTINCT xsd:decimal(?expensePaymentAmount)), 0) +
        COALESCE(SUM(DISTINCT xsd:decimal(?expenseReserveAmount)), 0) AS ?totalLoss)
WHERE {
  {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?coverage .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy ;
              in:hasPremiumAmount ?premium .

    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolder .

    ?policyHolder a in:PolicyHolder ;
                  in:policyHolderId ?policyHolderId .

    ?premium a in:Premium ;
             in:premiumAmount ?premiumAmount .

    OPTIONAL {
      ?claim in:hasLossPayment ?lossPayment .
      ?lossPayment in:lossPaymentAmount ?lossPaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lossReserve .
      ?lossReserve in:lossReserveAmount ?lossReserveAmount .
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?expensePayment .
      ?expensePayment in:expensePaymentAmount ?expensePaymentAmount .
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?expenseReserve .
      ?expenseReserve in:expenseReserveAmount ?expenseReserveAmount .
    }
  }
}
GROUP BY ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
ORDER BY ?claimNumber