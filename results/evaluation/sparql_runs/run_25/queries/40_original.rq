PREFIX in: <http://data.world/schema/insurance/>

SELECT ?agentId ?policyNumber
       (COALESCE(SUM(DISTINCT ?lossPaymentAmt), 0) +
        COALESCE(SUM(DISTINCT ?lossReserveAmt), 0) +
        COALESCE(SUM(DISTINCT ?expensePaymentAmt), 0) +
        COALESCE(SUM(DISTINCT ?expenseReserveAmt), 0) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .
    ?agent in:agentId ?agentId .

    ?pcd a in:PolicyCoverageDetail ;
         in:hasPolicy ?policy .

    ?claim a in:Claim ;
           in:against ?pcd .

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lpAmtRaw .
      BIND(xsd:decimal(?lpAmtRaw) AS ?lossPaymentAmt)
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lrAmtRaw .
      BIND(xsd:decimal(?lrAmtRaw) AS ?lossReserveAmt)
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?epAmtRaw .
      BIND(xsd:decimal(?epAmtRaw) AS ?expensePaymentAmt)
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?erAmtRaw .
      BIND(xsd:decimal(?erAmtRaw) AS ?expenseReserveAmt)
    }
  }
}
GROUP BY ?agentId ?policyNumber
ORDER BY ?agentId ?policyNumber