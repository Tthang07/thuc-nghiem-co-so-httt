PREFIX in: <http://data.world/schema/insurance/>

SELECT ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
       (COALESCE(SUM(?lossPaymentAmt), 0) AS ?totalLossPayment)
       (COALESCE(SUM(?lossReserveAmt), 0) AS ?totalLossReserve)
       (COALESCE(SUM(?expensePaymentAmt), 0) AS ?totalExpensePayment)
       (COALESCE(SUM(?expenseReserveAmt), 0) AS ?totalExpenseReserve)
       (COALESCE(SUM(?lossPaymentAmt), 0) +
        COALESCE(SUM(?lossReserveAmt), 0) +
        COALESCE(SUM(?expensePaymentAmt), 0) +
        COALESCE(SUM(?expenseReserveAmt), 0) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?claim a in:Claim ;
           in:claimNumber ?claimNumber ;
           in:against ?pcd .

    ?pcd in:hasPolicy ?policy .
    ?policy in:policyNumber ?policyNumber ;
            in:hasPolicyHolder ?policyHolder .
    ?policyHolder in:policyHolderId ?policyHolderId .

    OPTIONAL {
      ?pcd in:hasPremiumAmount ?premium .
      ?premium in:premiumAmount ?premiumAmount .
    }

    OPTIONAL {
      ?claim in:hasLossPayment ?lp .
      ?lp in:lossPaymentAmount ?lpVal .
      BIND(xsd:decimal(?lpVal) AS ?lossPaymentAmt)
    }

    OPTIONAL {
      ?claim in:hasLossReserve ?lr .
      ?lr in:lossReserveAmount ?lrVal .
      BIND(xsd:decimal(?lrVal) AS ?lossReserveAmt)
    }

    OPTIONAL {
      ?claim in:hasExpensePayment ?ep .
      ?ep in:expensePaymentAmount ?epVal .
      BIND(xsd:decimal(?epVal) AS ?expensePaymentAmt)
    }

    OPTIONAL {
      ?claim in:hasExpenseReserve ?er .
      ?er in:expenseReserveAmount ?erVal .
      BIND(xsd:decimal(?erVal) AS ?expenseReserveAmt)
    }
  }
}
GROUP BY ?claimNumber ?policyNumber ?policyHolderId ?premiumAmount
ORDER BY ?claimNumber ?policyNumber