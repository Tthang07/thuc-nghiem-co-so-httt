PREFIX in: <http://data.world/schema/insurance/>

SELECT ?policyNumber ?agentId
       (SUM(COALESCE(?lossPaymentVal, 0) + COALESCE(?lossReserveVal, 0)) AS ?totalLoss)
       (SUM(COALESCE(?premiumVal, 0)) AS ?totalPremium)
       ((SUM(COALESCE(?lossPaymentVal, 0) + COALESCE(?lossReserveVal, 0))) / SUM(COALESCE(?premiumVal, 0)) AS ?lossRatio)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .

    ?agent in:agentId ?agentId .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy ;
              in:hasPremiumAmount ?premiumNode .

    ?premiumNode in:premiumAmount ?premiumVal .

    OPTIONAL {
      ?claim a in:Claim ;
             in:against ?coverage .
      OPTIONAL {
        ?claim in:hasLossPayment ?lossPaymentNode .
        ?lossPaymentNode in:lossPaymentAmount ?lossPaymentVal .
      }
      OPTIONAL {
        ?claim in:hasLossReserve ?lossReserveNode .
        ?lossReserveNode in:lossReserveAmount ?lossReserveVal .
      }
    }
  }
}
GROUP BY ?policyNumber ?agentId
HAVING (SUM(COALESCE(?premiumVal, 0)) > 0)