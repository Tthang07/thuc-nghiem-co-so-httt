PREFIX in: <http://data.world/schema/insurance/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?agentId ?policyNumber
       (COALESCE(SUM(DISTINCT xsd:decimal(?lossPaymentAmount)), 0) AS ?totalLossPayment)
       (COALESCE(SUM(DISTINCT xsd:decimal(?lossReserveAmount)), 0) AS ?totalLossReserve)
       (COALESCE(SUM(DISTINCT xsd:decimal(?expensePaymentAmount)), 0) AS ?totalExpensePayment)
       (COALESCE(SUM(DISTINCT xsd:decimal(?expenseReserveAmount)), 0) AS ?totalExpenseReserve)
       ((COALESCE(SUM(DISTINCT xsd:decimal(?lossPaymentAmount)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?lossReserveAmount)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?expensePaymentAmount)), 0) +
         COALESCE(SUM(DISTINCT xsd:decimal(?expenseReserveAmount)), 0)) AS ?totalLoss)
WHERE {
  SERVICE <mapped> {
    ?policy a in:Policy ;
            in:policyNumber ?policyNumber ;
            in:soldByAgent ?agent .

    ?agent in:agentId ?agentId .

    ?coverage a in:PolicyCoverageDetail ;
              in:hasPolicy ?policy .

    OPTIONAL {
      ?claim a in:Claim ;
             in:against ?coverage .
      OPTIONAL {
        ?claim in:hasLossPayment ?lp .
        ?lp in:lossPaymentAmount ?lossPaymentAmount .
      }
      OPTIONAL {
        ?claim in:hasLossReserve ?lr .
        ?lr in:lossReserveAmount ?lossReserveAmount .
      }
      OPTIONAL {
        ?claim in:hasExpensePayment ?ep .
        ?ep in:expensePaymentAmount ?expensePaymentAmount .
      }
      OPTIONAL {
        ?claim in:hasExpenseReserve ?er .
        ?er in:expenseReserveAmount ?expenseReserveAmount .
      }
    }
  }
}
GROUP BY ?agentId ?policyNumber
ORDER BY ?agentId ?policyNumber